{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "stores": {
        ".read": "auth != null && auth.token.admin === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid || (auth != null && auth.token.admin === true)",
          ".write": false
        }
      },
      "couriers": {
        ".read": "auth != null && auth.token.admin === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid || (auth != null && auth.token.admin === true)",
          ".write": false
        }
      }
    },
    "orders": {
      ".read": "auth != null && auth.token.admin === true",
      "$orderId": {
        ".read": "auth != null && (auth.token.admin === true || data.child('storeId').val() === auth.uid || data.child('courierId').val() === auth.uid)",
        ".write": false
      }
    },
    "storeOrders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || (auth != null && auth.token.admin === true)",
        ".write": false
      }
    },
    "courierOrders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || (auth != null && auth.token.admin === true)",
        ".write": false
      }
    },
    "courierBids": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid || (auth != null && auth.token.admin === true)",
        ".write": false
      }
    },
    "availableOrders": {
      ".read": "(auth != null && root.child('profiles/couriers').child(auth.uid).exists()) || (auth != null && auth.token.admin === true)",
      ".write": false
    },
    "quoteBoard": {
      ".read": "(auth != null && root.child('profiles/couriers').child(auth.uid).exists()) || (auth != null && auth.token.admin === true)",
      ".write": false
    },
    "publicTracking": {
      "$token": {
        ".read": "data.exists() && data.child('revoked').val() === false && data.child('expiresAt').val() > now",
        ".write": false
      }
    },
    "courierPresence": {
      ".read": "auth != null && (auth.token.admin === true || root.child('profiles/stores').child(auth.uid).exists() || root.child('profiles/couriers').child(auth.uid).exists())",
      "$uid": {
        ".write": false,
        "availableForWork": {
          ".write": "auth != null && auth.uid === $uid && (auth != null && root.child('profiles/couriers').child(auth.uid).exists()) && newData.isBoolean()"
        }
      }
    },
    "courierConnections": {
      ".read": "auth != null && (auth.token.admin === true || root.child('profiles/stores').child(auth.uid).exists() || root.child('profiles/couriers').child(auth.uid).exists())",
      "$uid": {
        "$session": {
          ".write": "auth != null && auth.uid === $uid && (auth != null && root.child('profiles/couriers').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['lastSeen'])",
          "lastSeen": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "config": {
      "rates": {
        ".read": "auth != null && (auth.token.admin === true || root.child('profiles/stores').child(auth.uid).exists() || root.child('profiles/couriers').child(auth.uid).exists())",
        ".write": false
      }
    },
    "pushJobs": {
      ".indexOn": [
        "nextAt"
      ]
    },
    "alerts": {
      ".read": "auth != null && (auth.token.admin === true || root.child('profiles/stores').child(auth.uid).exists() || root.child('profiles/couriers').child(auth.uid).exists())",
      ".indexOn": [
        "expiresAt"
      ],
      "$alertId": {
        ".write": "(auth != null && (auth.token.admin === true || root.child('profiles/stores').child(auth.uid).exists() || root.child('profiles/couriers').child(auth.uid).exists())) && !data.exists() && newData.exists() && newData.child('senderId').val() === auth.uid",
        ".validate": "newData.hasChildren(['senderId','senderRole','senderName','message','createdAt','expiresAt'])",
        "senderId": {
          ".validate": "newData.val() === auth.uid"
        },
        "senderRole": {
          ".validate": "(newData.val() === 'store' && root.child('profiles/stores').child(auth.uid).exists()) || (newData.val() === 'courier' && root.child('profiles/couriers').child(auth.uid).exists())"
        },
        "senderName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80 && ((newData.parent().child('senderRole').val() === 'store' && newData.val() === root.child('profiles/stores').child(auth.uid).child('name').val()) || (newData.parent().child('senderRole').val() === 'courier' && newData.val() === root.child('profiles/couriers').child(auth.uid).child('name').val()))"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 120"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= newData.parent().child('createdAt').val() + 7200000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tokenId": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists()",
          ".validate": "newData.hasChildren(['token','platform','updatedAt'])",
          "token": {
            ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 4096"
          },
          "platform": {
            ".validate": "newData.val() === 'android'"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          },
          "deviceId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        }
      }
    },
    "pushPreferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (auth != null && root.child('profiles/couriers').child(auth.uid).exists()) && newData.exists()",
        "enabled": {
          ".validate": "newData.isBoolean()"
        },
        "orders": {
          ".validate": "newData.isBoolean()"
        },
        "quotes": {
          ".validate": "newData.isBoolean()"
        },
        "reminders": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pushSubscriptions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$device": {
          ".write": "auth != null && auth.uid === $uid && (auth != null && (root.child('profiles/stores').child(auth.uid).exists() || root.child('profiles/couriers').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['endpoint','keys','updatedAt'])",
          "endpoint": {
            ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val().beginsWith('https://fcm.googleapis.com/') || newData.val().beginsWith('https://web.push.apple.com/') || newData.val().matches(/^https:\\/\\/[a-z0-9-]+\\.push\\.services\\.mozilla\\.com\\/.+$/) || newData.val().matches(/^https:\\/\\/[a-z0-9.-]+\\.notify\\.windows\\.com\\/.+$/))"
          },
          "keys": {
            ".validate": "newData.hasChildren(['p256dh','auth'])",
            "p256dh": {
              ".validate": "newData.isString() && newData.val().length <= 256"
            },
            "auth": {
              ".validate": "newData.isString() && newData.val().length <= 256"
            },
            "$other": {
              ".validate": false
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
